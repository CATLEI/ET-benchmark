# WUCon thin image for Bohr Station custom-image UI (same workflow as wbp/Dockerfile.bohr).
#
# How to use on Bohrium:
#   1. Open 自定义镜像 / Dockerfile 构建
#   2. Paste this entire file as the Dockerfile
#   3. Build & push; put Image URI into yaml algorithms.wucon.docker_image
#
# Optional build args (defaults match WBP):
#   ET_DFLOW_REPO_URL  (default: https://github.com/CATLEI/ET-benchmark.git)
#   ET_DFLOW_REPO_REF   (default: main)

FROM registry.dp.tech/davinci/wucon:20260113160259

USER root
RUN mkdir -p /app
WORKDIR /tmp/etdflow-build

ARG ET_DFLOW_REPO_URL=https://github.com/CATLEI/ET-benchmark.git
ARG ET_DFLOW_REPO_REF=main

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN test -n "${ET_DFLOW_REPO_URL}" || \
    (echo "ET_DFLOW_REPO_URL build arg is required." >&2 && exit 1)

RUN git clone "${ET_DFLOW_REPO_URL}" repo && \
    cd repo && \
    git checkout "${ET_DFLOW_REPO_REF}"

WORKDIR /tmp/etdflow-build/repo

RUN python -m pip install --no-cache-dir --timeout 300 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements-etdflow-algorithm.txt && \
    python -m pip install --no-cache-dir --timeout 300 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple --no-deps .

RUN cp docker/algorithms/wucon/run_algorithm.py /app/run_algorithm.py && \
    cp docker/algorithms/wucon/docker-entrypoint.sh /app/docker-entrypoint.sh && \
    chmod +x /app/docker-entrypoint.sh

WORKDIR /app

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD []
