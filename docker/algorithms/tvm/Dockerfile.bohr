# TVM (TIGRE ASD-POCS) thin image for Bohr Station custom-image UI.
#
# How to use on Bohrium:
#   1. Open 自定义镜像 / Dockerfile 构建
#   2. Paste this entire file as the Dockerfile
#   3. Build & push; put Image URI into yaml algorithms.tvm.docker_image
#
# Optional build args:
#   ET_DFLOW_REPO_URL  (default: https://github.com/CATLEI/ET-benchmark.git)
#   ET_DFLOW_REPO_REF   (default: main)

FROM registry.dp.tech/davinci/tigre:20260113153441

USER root
RUN mkdir -p /app
WORKDIR /tmp/etdflow-build

ARG ET_DFLOW_REPO_URL=https://github.com/CATLEI/ET-benchmark.git
ARG ET_DFLOW_REPO_REF=main

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN test -n "${ET_DFLOW_REPO_URL}" || \
    (echo "ET_DFLOW_REPO_URL build arg is required." >&2 && exit 1)

# Bohrium builders hit GnuTLS recv error -110 on GitHub HTTP/2.
# HTTP/1.1 plus a shallow clone, retried, is the combination that finishes.
RUN ok=0; \
    for i in 1 2 3 4 5; do \
      rm -rf repo; \
      if git -c http.version=HTTP/1.1 -c http.postBuffer=524288000 \
           clone --depth 1 --branch "${ET_DFLOW_REPO_REF}" \
           "${ET_DFLOW_REPO_URL}" repo; then \
        ok=1; \
        break; \
      fi; \
      echo "git clone attempt ${i} failed, retrying..." >&2; \
      sleep $((i * 5)); \
    done; \
    test "$ok" = 1

WORKDIR /tmp/etdflow-build/repo

# Base davinci/tigre often ships only ``python3`` (no ``python`` on PATH).
RUN if ! command -v python >/dev/null 2>&1; then \
      PY=""; \
      for c in python3 /usr/local/bin/python3 /usr/bin/python3 \
               /opt/conda/bin/python /root/miniconda3/bin/python; do \
        if command -v "$c" >/dev/null 2>&1 || [ -x "$c" ]; then PY="$c"; break; fi; \
      done; \
      if [ -z "$PY" ]; then echo "No python/python3 found in base image" >&2; exit 1; fi; \
      ln -sf "$(command -v "$PY" 2>/dev/null || echo "$PY")" /usr/local/bin/python; \
    fi && \
    python -m pip install --no-cache-dir --timeout 300 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements-etdflow-algorithm.txt && \
    python -m pip install --no-cache-dir --timeout 300 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple --no-deps .

RUN cp docker/algorithms/tvm/run_algorithm.py /app/run_algorithm.py && \
    cp docker/algorithms/tvm/docker-entrypoint.sh /app/docker-entrypoint.sh && \
    chmod +x /app/docker-entrypoint.sh

WORKDIR /app

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD []
