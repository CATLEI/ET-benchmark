# DeepDeWedge thin image for Bohr Station custom-image UI.
# Protects CUDA torch from being replaced by PyPI CPU wheels (+cpu).
#
# Paste this ENTIRE file into Bohr. Optional build args:
#   ET_DFLOW_REPO_URL  default https://github.com/CATLEI/ET-benchmark.git
#   ET_DFLOW_REPO_REF   default main
#   TORCH_INDEX_URL     default https://download.pytorch.org/whl/cu121
#   TORCH_VERSION       default: strip +cpu/+cu from base torch (e.g. 2.2.0)

FROM registry.dp.tech/davinci/deepdewedge:20260113145259

USER root
RUN mkdir -p /app /tmp/etdflow-scripts
WORKDIR /tmp/etdflow-build

ARG ET_DFLOW_REPO_URL=https://github.com/CATLEI/ET-benchmark.git
ARG ET_DFLOW_REPO_REF=main
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
ARG TORCH_VERSION=

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN test -n "${ET_DFLOW_REPO_URL}" || \
    (echo "ET_DFLOW_REPO_URL build arg is required." >&2 && exit 1)

RUN git clone "${ET_DFLOW_REPO_URL}" repo && \
    cd repo && \
    git checkout "${ET_DFLOW_REPO_REF}"

WORKDIR /tmp/etdflow-build/repo

# Decode helper scripts (no shell heredoc; Bohr UI validators often reject <<EOF).
RUN echo '' \
    | base64 -d > /tmp/etdflow-scripts/torch_pre.py \
    && echo '' \
    | base64 -d > /tmp/etdflow-scripts/torch_post.py

RUN python /tmp/etdflow-scripts/torch_pre.py

RUN python -m pip install --no-cache-dir --timeout 300 \
    --upgrade-strategy only-if-needed \
    -c /tmp/torch-constraints.txt \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    -r requirements-etdflow-algorithm.txt && \
    python -m pip install --no-cache-dir --timeout 300 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple --no-deps .

# Clean reinstall CUDA torch if CPU/broken (avoids GradScaler mixed-install errors).
RUN TORCH_INDEX_URL="${TORCH_INDEX_URL}" TORCH_VERSION="${TORCH_VERSION}" \
    python /tmp/etdflow-scripts/torch_post.py

RUN cp docker/algorithms/deepdewedge/run_algorithm.py /app/run_algorithm.py

RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -e' \
    'if [ -n "${CUDA_VISIBLE_DEVICES+x}" ] && [ -z "${CUDA_VISIBLE_DEVICES}" ]; then unset CUDA_VISIBLE_DEVICES; fi' \
    'if [ $# -eq 0 ]; then exec python /app/run_algorithm.py --help; fi' \
    'if [ "$1" = "python" ] || [ "$1" = "bash" ] || [ "$1" = "sh" ] || [ "$1" = "/bin/bash" ] || [ "$1" = "/bin/sh" ]; then exec "$@"; fi' \
    'exec python /app/run_algorithm.py "$@"' \
    > /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

WORKDIR /app

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD []
